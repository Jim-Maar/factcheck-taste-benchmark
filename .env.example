# Copy to .env and fill in. Never commit .env.

# Site (public values, also set as Actions variables for the deploy)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Benchmark export: direct PostgreSQL URL (never a VITE_ variable)
DATABASE_URL=

# Import and AI scripts
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Path to cn-return-bot's env file (the import reads commonnotes from its database)
CN_SOURCE_ENV=
# Groq, whose Whisper writes the video transcripts (bun scripts/import/index.ts transcripts)
GROQ_API_KEY=
